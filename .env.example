# ==========================================================
# LEGALTA ENVIRONMENT CONFIGURATION
# ==========================================================
PORT=3000

# SUPABASE CONFIGURATION
# Ambil Project URL dan Anon API Key dari Dashboard Supabase Anda:
# Masuk ke: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# (Opsional) Service Role Key untuk operasi administratif backend:
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LOCAL SQLITE DATABASE (Digunakan otomatis sebagai fallback jika Supabase belum diisi)
DB_PATH=database/legalta.sqlite
