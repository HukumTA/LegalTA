# ==========================================================
# LEGALTA ENVIRONMENT CONFIGURATION (TEMPLATE)
# Salin file ini menjadi .env lalu isi nilainya:
# cp .env.example .env
# ==========================================================
PORT=3000

# ----------------------------------------------------------
# 1. PRISMA ORM & POSTGRESQL (SUPABASE CONNECTION STRINGS)
# ----------------------------------------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string:
# Mode Transaction (Pooler / IPv4 - Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Mode Session (Direct / Session Pooler - Port 5432 untuk migrasi Prisma)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ----------------------------------------------------------
# 2. SUPABASE API CLIENT
# ----------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."

# ----------------------------------------------------------
# 3. LOCAL SQLITE DATABASE (ZERO-CONFIG FALLBACK)
# ----------------------------------------------------------
DB_PATH=database/sqlite/legalta.sqlite
