# ==========================================================
# LEGALTA ENVIRONMENT CONFIGURATION
# ==========================================================
PORT=3000

# ----------------------------------------------------------
# 1. PRISMA ORM & POSTGRESQL (SUPABASE CONNECTION STRINGS)
# ----------------------------------------------------------
# Salin dari Supabase Dashboard -> Project Settings -> Database:
#
# DATABASE_URL: Mode "Session" atau "Transaction" (Port 6543) dengan pooler
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Mode "Direct connection" (Port 5432) khusus Prisma CLI (db push / migrate)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# ----------------------------------------------------------
# 2. SUPABASE API CLIENT (REST / REALTIME)
# ----------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ----------------------------------------------------------
# 3. LOCAL SQLITE DATABASE (ZERO-CONFIG FALLBACK)
# ----------------------------------------------------------
DB_PATH=database/legalta.sqlite
