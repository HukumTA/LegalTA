generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  name              String
  email             String     @unique
  passwordHash      String?    @map("password_hash")
  phoneNumber       String?    @map("phone_number")
  role              String     @default("CLIENT")
  avatarUrl         String?    @map("avatar_url")
  createdAt         DateTime?  @default(now()) @map("created_at") @db.Timestamptz(6)
  uploadedDocuments Document[] @relation("UserUploadedDocs")
  plaOrders         Order[]    @relation("PlaAssignedOrders")
  clientOrders      Order[]    @relation("ClientOrders")

  @@map("users")
}

model ServiceCategory {
  id          BigInt    @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  services    Service[]

  @@map("service_categories")
}

model Service {
  id            BigInt          @id @default(autoincrement())
  categoryId    BigInt          @map("category_id")
  title         String
  slug          String          @unique
  description   String?
  basePrice     Decimal         @default(0) @map("base_price") @db.Decimal(15, 2)
  estimatedDays Int?            @default(3) @map("estimated_days")
  orders        Order[]
  category      ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([categoryId], map: "idx_services_category_id")
  @@map("services")
}

model Order {
  id            String          @id
  userId        String          @map("user_id")
  serviceId     BigInt          @map("service_id")
  plaId         String?         @map("pla_id")
  title         String
  status        String          @default("PENDING")
  totalAmount   Decimal         @default(0) @map("total_amount") @db.Decimal(15, 2)
  voucherCode   String?         @map("voucher_code")
  kemenkumhamId String?         @map("kemenkumham_id")
  createdAt     DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  documents     Document[]
  trackingSteps OrderTracking[]
  pla           User?           @relation("PlaAssignedOrders", fields: [plaId], references: [id], onUpdate: NoAction)
  service       Service         @relation(fields: [serviceId], references: [id], onUpdate: NoAction)
  user          User            @relation("ClientOrders", fields: [userId], references: [id], onUpdate: NoAction)

  @@index([serviceId], map: "idx_orders_service_id")
  @@index([userId], map: "idx_orders_user_id")
  @@map("orders")
}

model OrderTracking {
  id          BigInt    @id @default(autoincrement())
  orderId     String    @map("order_id")
  stepNumber  Int       @map("step_number")
  stepName    String    @map("step_name")
  status      String    @default("PENDING")
  description String?
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([orderId, stepNumber], map: "uq_order_step")
  @@index([orderId], map: "idx_order_tracking_order_id")
  @@map("order_tracking")
}

model Document {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderId    String    @map("order_id")
  uploadedBy String?   @map("uploaded_by")
  fileName   String    @map("file_name")
  fileUrl    String    @map("file_url")
  fileSize   String?   @map("file_size")
  docType    String    @default("OTHER") @map("doc_type")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploader   User?     @relation("UserUploadedDocs", fields: [uploadedBy], references: [id], onUpdate: NoAction)

  @@index([orderId], map: "idx_documents_order_id")
  @@map("documents")
}

model Consultation {
  id            BigInt    @id @default(autoincrement())
  clientName    String    @map("client_name")
  phoneNumber   String    @map("phone_number")
  email         String
  city          String?
  serviceSlug   String?   @map("service_slug")
  consultMethod String?   @default("whatsapp") @map("consult_method")
  notes         String?
  status        String?   @default("NEW")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("consultations")
}

model KbliItem {
  code            String @id
  title           String
  category        String
  sectorName      String @map("sector_name")
  description     String
  riskLevel       String @map("risk_level")
  permitsRequired String @map("permits_required")
  dpiRules        String @map("dpi_rules")

  @@index([code], map: "idx_kbli_code")
  @@map("kbli_items")
}

model RegisteredPt {
  id               BigInt    @id @default(autoincrement())
  name             String    @unique
  status           String?   @default("ACTIVE")
  ahuNumber        String?   @map("ahu_number")
  registrationDate DateTime? @map("registration_date") @db.Date

  @@index([name], map: "idx_registered_pts_name")
  @@map("registered_pts")
}

model RegisteredTrademark {
  id                BigInt  @id @default(autoincrement())
  brandName         String  @map("brand_name")
  niceClass         Int     @map("nice_class")
  applicationNumber String  @unique @map("application_number")
  ownerName         String  @map("owner_name")
  status            String
  phoneticKey       String? @map("phonetic_key")

  @@index([brandName], map: "idx_registered_trademarks_brand")
  @@map("registered_trademarks")
}
